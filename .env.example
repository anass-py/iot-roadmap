# Copier en .env et remplir. Le vrai .env n'est jamais committé.
# Toutes ces variables ont une valeur par défaut dans src/iot/config.py,
# sauf les deux tokens Telegram.

# ---------- Base de données ----------
DATABASE_URL=postgresql://postgres:devpass@localhost:5432/postgres

# ---------- MQTT ----------
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_PUBLIC_BROKER=broker.emqx.io
MQTT_PUBLIC_PORT=1883

# ---------- API ----------
API_KEY=change-moi

# ---------- Alertes Telegram ----------
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
